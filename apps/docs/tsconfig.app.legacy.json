/* The tsconfig of the legacy builders (`build-legacy`, `serve-legacy`), created by
   `ng g @ng-doc/builder:migrate-to-vite`. It maps `@ng-doc/generated` to their own
   generated folder in `ng-doc-legacy/`. */
{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@ng-doc/generated": ["ng-doc-legacy/ng-doc/docs/index.ts"],
      "@ng-doc/generated/*": ["ng-doc-legacy/ng-doc/docs/*"],
      "@workletjs/ngx-openlayers/*": ["packages/ngx-openlayers/*"]
    }
  }
}
