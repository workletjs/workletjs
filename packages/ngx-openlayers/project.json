{
  "name": "ngx-openlayers",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ngx-openlayers",
  "prefix": "wol",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/scripts/package-schematics.mjs",
        "{workspaceRoot}/scripts/build-schematics.mjs"
      ],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "dependsOn": [
        {
          "target": "package",
          "params": "forward"
        },
        "^build"
      ],
      "defaultConfiguration": "production",
      "options": {
        "command": "node scripts/package-schematics.mjs"
      },
      "configurations": {
        "production": {},
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "package": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/ngx-openlayers/ng-package.json",
        "tsConfig": "packages/ngx-openlayers/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/ngx-openlayers/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    }
  },
  "implicitDependencies": ["schematics"]
}
